# Copy this to .env for local testing, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, etc).
# NEVER commit real keys to a public GitHub repo.

# From Supabase Dashboard > Project Settings > API
# SUPABASE_URL is the Project URL; SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key — this server needs
# full read/write access and bypasses Row Level Security).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paid events (ONVO Pay). Secret key from the ONVO Dashboard — use the
# onvo_test_… key until you're ready to take real payments.
ONVO_SECRET_KEY=
# Signing secret (whsec_…) of the webhook endpoint pointing at
# https://your-deployed-url.com/api/onvo/webhook (Desarrolladores > Webhooks)
ONVO_WEBHOOK_SECRET=
# Optional: who can create/edit/cancel events (comma-separated). Defaults
# to foursomeapp.golf@gmail.com.
EVENT_ADMIN_EMAILS=

PORT=3000

# Push notifications (Web Push). Generate a keypair once with:
#   npx web-push generate-vapid-keys
# then paste the values below. VAPID_SUBJECT should be a mailto: link or
# your site URL — it's required by the push spec, not shown to users.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Emails you when a user report comes in. From resend.com (free tier) —
# Dashboard > API Keys > Create API Key. Sign up with the same address as
# ADMIN_EMAIL in server.js (foursomeapp.golf@gmail.com) so sending from
# Resend's no-setup onboarding@resend.dev sender works without verifying a
# domain. Without this set, reports still save to the database — you just
# won't get emailed about them.
RESEND_API_KEY=
