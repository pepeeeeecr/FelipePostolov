# Copy this to .env for local testing, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, etc).
# NEVER commit real keys to a public GitHub repo.

# From Supabase Dashboard > Project Settings > API
# SUPABASE_URL is the Project URL; SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key — this server needs
# full read/write access and bypasses Row Level Security).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From Stripe Dashboard > Developers > API keys (use the SECRET key, starts with sk_)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# From Stripe Dashboard > Developers > Webhooks, after you create the
# webhook endpoint pointing at https://your-deployed-url.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# The Price ID for your $10/mo Foursome Pro product
# (Stripe Dashboard > Product catalog > your product > click the price > copy the ID, starts with price_)
STRIPE_PRICE_ID=price_xxxxxxxxxxxx

PORT=3000

# Push notifications (Web Push). Generate a keypair once with:
#   npx web-push generate-vapid-keys
# then paste the values below. VAPID_SUBJECT should be a mailto: link or
# your site URL — it's required by the push spec, not shown to users.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
